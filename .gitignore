# Secrets: API tokens (Kaggle, Hugging Face) live here, never in git.
.env

# Demo bundles carry features derived from the IEEE-CIS competition data, which
# Kaggle's rules do not allow redistributing; they are shared separately.
fraud-detection-demo-bundle*/

# Environments and caches
.venv/
node_modules/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# Data. The IEEE-CIS tables are ~700 MB and are obtained per-clone with
# `python -m frds acquire`; every derived file is rebuilt by the pipeline.
data/**
!data/**/.gitkeep

# Trained models and score checkpoints - regenerated by `python -m frds train`.
artifacts/**
!artifacts/.gitkeep

# Everything under reports/ is generated: figures, tables, metric JSON, the
# experiment output trees (several GB of per-cell artifacts) and the built
# report documents. The documents additionally carry personal contact details
# from the project-details page, which is a second reason not to track them.
reports/**
!reports/.gitkeep

*.log
mlruns/

# setuptools build metadata
*.egg-info/

# editor/tooling config
.claude/

# Phase-1 review deck: superseded, not part of the submission.
Phase-1_Fraud_Detection_Presentation.pptx

# Local working notes, not part of the project.
CLAUDE.md
docs/PROJECT_STATUS.md
